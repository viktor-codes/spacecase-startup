# Copy to .env and adjust (never commit .env):
#   cp .env.example .env

# --- Database (PostgreSQL + asyncpg) ---
# Local: run `docker compose up -d` from repo root, then use URL below.
# SQLite fallback (no Docker): sqlite+aiosqlite:///./CosmicCase.db
DATABASE_URL=postgresql+asyncpg://cosmiccase:cosmiccase_dev@127.0.0.1:5433/cosmiccase

# --- Stripe (test mode) — Dashboard → Developers → API keys ---
STRIPE_SECRET_KEY=sk_test_replace_with_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret
# Products → Prices → copy Price IDs for each shipping option
STRIPE_PRICE_ID_STANDARD=price_replace_with_standard_test_price_id
STRIPE_PRICE_ID_EXPRESS=price_replace_with_express_test_price_id

# --- App URLs (local) ---
FRONTEND_BASE_URL=http://localhost:3000
# Optional: extra CORS origins (comma-separated)
# CORS_ALLOW_ORIGINS=

# --- NASA ---
NASA_API_KEY=DEMO_KEY

# --- Optional ---
# DEBUG=true
# SENTRY_DSN=
