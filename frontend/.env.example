# Copy to .env.local (Next.js convention) or .env:
#   cp .env.example .env.local

# Backend API (local uvicorn on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used for metadata, OG URLs — match how you open the site locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
